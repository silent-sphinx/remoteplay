# Required: Navidrome connection
NAVIDROME_URL=http://your-navidrome-host:4533
NAVIDROME_USER=your-username
NAVIDROME_PASSWORD=your-password

# Optional: path to the mpv binary if it is not on PATH
# MPV=/Applications/mpv.app/Contents/MacOS/mpv

# Optional: playback and streaming (defaults shown)
# REMOTEPLAY_STREAM_MAX_BITRATE=320
# REMOTEPLAY_DEFAULT_VOLUME=0.8
# REMOTEPLAY_SCROBBLE_THRESHOLD_SECONDS=240

# Optional: where the selected audio output is saved (default: .remoteplay-settings.json in the project root)
# REMOTEPLAY_SETTINGS_FILE=/var/lib/remoteplay/settings.json

# Optional: cover art cache (see README)
# REMOTEPLAY_COVER_CACHE=/var/cache/remoteplay/covers
# REMOTEPLAY_COVER_CONCURRENCY=4
# REMOTEPLAY_COVER_CACHE_ENTRIES=3000
